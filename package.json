{
  "name": "prop-firm-rules",
  "version": "0.1.0",
  "description": "Prop firm challenge rules engine for TypeScript: profit target, max daily loss, max overall loss, trailing drawdown, minimum and maximum trading days, and consistency, evaluated against an account's balance and equity history.",
  "keywords": [
    "prop firm",
    "prop trading",
    "funded trader",
    "trading challenge",
    "drawdown",
    "trailing drawdown",
    "daily loss limit",
    "evaluation",
    "risk management",
    "metatrader",
    "prop-firm",
    "profit target",
    "max drawdown",
    "consistency rule",
    "mt4",
    "mt5",
    "forex",
    "futures",
    "typescript"
  ],
  "homepage": "https://github.com/PropSim-Enterprise/prop-firm-rules",
  "bugs": {
    "url": "https://github.com/PropSim-Enterprise/prop-firm-rules/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PropSim-Enterprise/prop-firm-rules.git"
  },
  "license": "MIT",
  "author": "PropSim (https://propsim.markets)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
